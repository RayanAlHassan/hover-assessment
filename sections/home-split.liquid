{{ 'section-product-selection.css' | asset_url | stylesheet_tag }}
{{ 'section-product-accordions.css' | asset_url | stylesheet_tag }}
{{ 'section-custom-product.css' | asset_url | stylesheet_tag }}

<style>
  .home-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  @media (max-width: 990px) {
    .home-split { grid-template-columns: 1fr; }
  }
  .home-left, .home-right { min-width: 0; }
</style>

<div class="page-width">
  <div class="home-split">
    <!-- LEFT: Custom Product Details (gallery) -->
    <div class="home-left">
      <div class="product-custom-details">
        <div class="custom-grid">
          <div class="custom-media">
            <div class="image-gallery-wrapper" id="Gallery-{{ section.id }}">
              {%- for block in section.blocks -%}
                {%- if block.type == 'gallery_image' -%}
                  <div class="gallery-item" {{ block.shopify_attributes }}>
                    {% if block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'gallery-img' }}
                    {% endif %}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <div class="custom-content">
            {%- if section.settings.left_heading != blank -%}
              <h2>{{ section.settings.left_heading }}</h2>
            {%- endif -%}
            {{ section.settings.left_description }}
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Product Selection + Accordions -->
    <div class="home-right">
      <!-- Product Selection -->
      <div class="product-selection-section">
        <div class="header-meta">
          <div class="tp-container">
            <span class="reviews-count">{{ section.settings.ps_reviews1_text}}</span>

            {% if section.settings.trust_stars != blank %}
              <img src="{{section.settings.ps_trust_stars | image_url: width: 80 }}" class="tp-stars" alt="Stars">
            {% endif %}

            <span class="reviews-count">{{ section.settings.ps_reviews_text}}</span>

            {% if section.settings.trust_logo != blank %}
              <img src="{{ section.settings.ps_trust_logo | image_url: width: 80 }}" class="tp-logo" alt="Trustpilot">
            {% endif %}
          </div>
        </div>

        <div class="title-price-row">
          <h1 class="product-title">{{ section.settings.ps_title }}

</h1>
          <div class="product-price">{{ section.settings.ps_price }}
</div>
        </div>

        <div class="product-description">
{{ section.settings.ps_main_text }}
        </div>

        <ul class="custom-check-list">
          {% if section.settings.bullet_1 != blank %}
            <li><img src="{{ section.settings.ps_check_icon
| image_url: width: 20 }}" class="check-img"> <span> {{section.settings.ps_bullet_1}} </span></li>
          {% endif %}
          {% if section.settings.bullet_2 != blank %}
            <li><img src="{{section.settings.ps_check_icon
| image_url: width: 20 }}" class="check-img"> <span>{{section.settings.ps_bullet_2}}</span></li>
          {% endif %}
          {% if section.settings.bullet_3 != blank %}
            <li><img src="{{ section.settings.ps_check_icon
| image_url: width: 20 }}" class="check-img"> <span>{{section.settings.ps_bullet_3}}</span></li>
          {% endif %}
        </ul>

        <div class="purchase-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'plan_card' -%}
              <div class="plan-card {% if forloop.first %}card-blue{% endif %}" {{ block.shopify_attributes }}>
                {% if block.settings.badge != blank %}
                  <span class="plan-badge">{{ block.settings.badge }}</span>
                {% endif %}
                <div class="plan-content">
                  <h3 class="plan-duration">{{ block.settings.duration }}</h3>
                  <div class="plan-subtext">{{ block.settings.sub_text }}</div>
                  {% if block.settings.discount != blank %}
                    <span class="plan-discount">{{ block.settings.discount }}</span>
                  {% endif %}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="atc-container">
          <button class="add-to-cart-btn">
          {{ section.settings.ps_btn_text }}
 |{{ section.settings.ps_initial_price }}

          </button>
          <div class="shipping-info">{{ section.settings.ps_shipping_text }}
</div>
        </div>
      </div>

      <!-- Accordions -->
      <div class="product-accordions-section">
        <div class="product-accordions">
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion_row' -%}
              <div class="accordion-item" {{ block.shopify_attributes }}>
                <div class="accordion-header">
                  <div class="accordion-title-wrapper">
                    <span class="accordion-title">{{ block.settings.acc_title }}</span>
                  </div>

                  <button
                    type="button"
                    class="accordion-toggle"
                    aria-expanded="false"
                    aria-controls="accordion-content-{{ section.id }}-{{ forloop.index }}"
                    onclick="toggleAccordion(this)"
                  >
                    {%- if section.settings.arrow_icon != blank -%}
                      <img
                        src="{{ section.settings.arrow_icon | image_url: width: 40 }}"
                        class="accordion-arrow"
                        alt="Toggle"
                        loading="lazy"
                      >
                    {%- else -%}
                      <span class="chevron-down" aria-hidden="true">▼</span>
                    {%- endif -%}
                  </button>
                </div>

                <div class="accordion-content" id="accordion-content-{{ section.id }}-{{ forloop.index }}">
                  {{ block.settings.acc_content }}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleAccordion(toggleBtn) {
    const item = toggleBtn.closest('.accordion-item');
    const content = item.querySelector('.accordion-content');
    const isOpen = item.classList.contains('is-open');

    item.classList.toggle('is-open');
    content.style.display = isOpen ? 'none' : 'block';
    toggleBtn.setAttribute('aria-expanded', String(!isOpen));
  }
</script>
{% schema %}
{
  "name": "Home Split",
  "settings": [
    { "type": "text", "id": "left_heading", "label": "Left heading", "default": "Lorem Ipsum" },
    { "type": "richtext", "id": "left_description", "label": "Left description" },

    { "type": "image_picker", "id": "ps_trust_logo", "label": "Trustpilot Logo" },
    { "type": "image_picker", "id": "ps_trust_stars", "label": "Trustpilot Stars" },
    { "type": "inline_richtext", "id": "ps_reviews1_text", "label": "Review Text 1", "default": "Excellent" },
    { "type": "inline_richtext", "id": "ps_reviews_text", "label": "Review Text", "default": "17.102 avis" },

    { "type": "inline_richtext", "id": "ps_title", "label": "Product Title", "default": "Lorem ipsum" },
    { "type": "inline_richtext", "id": "ps_price", "label": "Product Price", "default": "35,00€" },
    { "type": "richtext", "id": "ps_main_text", "label": "Description Paragraph" },

    { "type": "image_picker", "id": "ps_check_icon", "label": "Checkmark Image" },
    { "type": "inline_richtext", "id": "ps_bullet_1", "label": "Bullet 1" },
    { "type": "inline_richtext", "id": "ps_bullet_2", "label": "Bullet 2" },
    { "type": "inline_richtext", "id": "ps_bullet_3", "label": "Bullet 3" },

    { "type": "inline_richtext", "id": "ps_btn_text", "label": "Button Text", "default": "Ajouter au panier" },
    { "type": "inline_richtext", "id": "ps_initial_price", "label": "Button Price", "default": "35€" },
    { "type": "inline_richtext", "id": "ps_shipping_text", "label": "Shipping Info", "default": "En stock, commandez maintenant" },

    { "type": "image_picker", "id": "arrow_icon", "label": "Accordion Arrow Image" }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    },
    {
      "type": "plan_card",
      "name": "Plan card",
      "limit": 2,
      "settings": [
        { "type": "inline_richtext", "id": "badge", "label": "Badge" },
        { "type": "inline_richtext", "id": "duration", "label": "Duration" },
        { "type": "inline_richtext", "id": "sub_text", "label": "Subtext" },
        { "type": "inline_richtext", "id": "discount", "label": "Discount" }
      ]
    },
    {
      "type": "accordion_row",
      "name": "Accordion row",
      "settings": [
        { "type": "inline_richtext", "id": "acc_title", "label": "Title", "default": "Accordion Title" },
        { "type": "richtext", "id": "acc_content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    { "name": "Home Split" }
  ]
}
{% endschema %}
