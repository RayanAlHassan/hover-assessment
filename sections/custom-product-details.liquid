{{ 'section-custom-product.css' | asset_url | stylesheet_tag }}

<div class="product-custom-details page-width">
  <div class="custom-grid">
    <div class="custom-media">
      <div class="image-gallery-wrapper" id="Gallery-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' -%}
            <div class="gallery-item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'gallery-img' }}
              {% endif %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="custom-content">
       </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Product Details",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lorem Ipsum" },
    { "type": "richtext", "id": "description", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Accordion Row",
      "settings": [
        { "type": "text", "id": "title", "label": "Row Title", "default": "Bienfaits et Efficacité" },
        { "type": "richtext", "id": "content", "label": "Row Content" }
      ]
    }
  ],
  "presets": [
    { "name": "Custom Product Details" }
  ]
}
{% endschema %}
